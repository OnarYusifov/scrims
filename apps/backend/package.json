{
  "name": "@trayb/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node --external react-dom",
    "start": "bun run dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "seed:test-user": "bun run scripts/seed-test-user.ts",
    "verify:test-user": "bun run scripts/verify-test-user.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@react-email/components": "^1.0.1",
    "@react-email/render": "^2.0.0",
    "@trayb/config": "workspace:*",
    "@trayb/db": "workspace:*",
    "@trayb/types": "workspace:*",
    "@types/openid": "^2.0.5",
    "@types/react": "^19.2.4",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "nodemailer": "^7.0.10",
    "openid": "^2.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^5.0.4",
    "resend": "^6.4.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8",
    "zod-openapi": "^5.4.3",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.4"
  }
}
