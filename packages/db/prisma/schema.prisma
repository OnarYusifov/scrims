// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(cuid())
  username                String    @unique
  email                   String    @unique
  password                String?   // Nullable for social login users
  image                   String?   // Profile picture URL (from OAuth providers)
  discord                 String?   // Discord user ID or username
  role                    String    @default("user") // user, admin, etc.
  status                  String    @default("active")
  emailVerified           DateTime? // DateTime for Auth.js compatibility (null = not verified, Date = verified)
  verificationToken       String?   // Keep for backward compatibility, but use verificationCode
  verificationCode        String?   // 6-digit OTP code for email verification
  verificationCodeExpiry  DateTime? // OTP expiry (typically 10-15 minutes)
  loginCode               String?   // 6-digit OTP code for login
  loginCodeExpiry         DateTime? // Login OTP expiry (typically 10-15 minutes)
  passwordResetCode       String?   // 6-digit OTP code for password reset
  passwordResetCodeExpiry DateTime? // Password reset OTP expiry (typically 10-15 minutes)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Auth.js relations
  accounts                Account[]
  sessions                Session[]
  passwordHistory         PasswordHistory[]
  
  // User badges
  userBadges              UserBadge[]

  playerRoles             PlayerRole[]
  assignedRoles           PlayerRole[]        @relation("PlayerRoleAssignedBy")
  playerBans              PlayerBan[]
  issuedBans              PlayerBan[]         @relation("PlayerBanActor")
  auditLogs               PlayerAuditLog[]    @relation("PlayerAuditTarget")
  auditActions            PlayerAuditLog[]    @relation("PlayerAuditActor")
  matchPlayers            MatchPlayer[]
  eloHistory              PlayerEloHistory[]

  @@map("users")
}

// Auth.js required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Password history to prevent reusing last 5 passwords
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  password  String   // Hashed password
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

// Badge definitions - managed by admin
model Badge {
  id          String      @id @default(cuid())
  label       String      // e.g., "Early Member", "Founder", "Beta Tester"
  variant     String      @default("default") // "default" | "secondary" | "destructive" | "outline"
  icon        String?     // Optional icon identifier or emoji
  description String?     // Description for admin panel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Many-to-many relationship with users
  userBadges  UserBadge[]

  @@map("badges")
}

// User-Badge relationship (many-to-many)
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId]) // Prevent duplicate badges per user
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

enum PlayerRoleType {
  organizer
  admin
  moderator
  competitor
  viewer
}

model PlayerRole {
  id         String         @id @default(cuid())
  userId     String
  role       PlayerRoleType
  isPrimary  Boolean        @default(false)
  reason     String?
  assignedBy String?
  createdAt  DateTime       @default(now())

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("PlayerRoleAssignedBy", fields: [assignedBy], references: [id])

  @@unique([userId, role])
  @@map("player_roles")
}

enum PlayerBanStatus {
  active
  lifted
  expired
}

enum PlayerBanType {
  temporary
  permanent
}

model PlayerBan {
  id              String           @id @default(cuid())
  userId          String
  status          PlayerBanStatus  @default(active)
  type            PlayerBanType
  reason          String
  durationDays    Int?
  banFromAllHubs  Boolean          @default(true)
  banFromDiscord  Boolean          @default(false)
  bannedBy        String
  startsAt        DateTime         @default(now())
  endsAt          DateTime?
  liftedAt        DateTime?
  createdAt       DateTime         @default(now())

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("PlayerBanActor", fields: [bannedBy], references: [id])

  @@index([userId, status])
  @@map("player_bans")
}

enum PlayerAuditAction {
  role_change
  ban
  unban
  note
}

model PlayerAuditLog {
  id        String             @id @default(cuid())
  userId    String
  actorId   String
  action    PlayerAuditAction
  reason    String?
  metadata  Json?
  createdAt DateTime           @default(now())

  user  User @relation("PlayerAuditTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("PlayerAuditActor", fields: [actorId], references: [id])

  @@index([userId, createdAt])
  @@map("player_audit_logs")
}

model AdminSetting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_settings")
}

enum GameId {
  valorant
  cs2
}

enum MatchStatus {
  scheduled
  live
  completed
  canceled
}

enum MatchOutcome {
  alpha
  bravo
  draw
}

enum MatchTeam {
  alpha
  bravo
}

enum MatchQueueType {
  ranked_global
  ranked_private
  unranked
  scrim
}

model Match {
  id             String         @id @default(cuid())
  externalId     String?        @unique
  hubId          String?
  game           GameId
  status         MatchStatus    @default(completed)
  queueType      MatchQueueType @default(ranked_global)
  map            String
  roundsPlayed   Int            @default(24)
  winner         MatchOutcome?
  startedAt      DateTime?
  endedAt        DateTime?
  durationSeconds Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  players        MatchPlayer[]
  eloEvents      PlayerEloHistory[] @relation("MatchEloEvents")

  @@index([game, startedAt])
  @@index([hubId])
}

model MatchPlayer {
  id            String     @id @default(cuid())
  matchId       String
  userId        String
  team          MatchTeam
  ratingBefore  Int?
  ratingAfter   Int?
  ratingDelta   Int?
  kills         Int?
  deaths        Int?
  assists       Int?
  acs           Int?
  hsPercentage  Float?
  entryKills    Int?
  clutches      Int?
  createdAt     DateTime   @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([userId, matchId])
}

model PlayerEloHistory {
  id            String   @id @default(cuid())
  userId        String
  game          GameId
  rating        Int
  ratingDelta   Int
  recordedAt    DateTime @default(now())
  sourceMatchId String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match? @relation("MatchEloEvents", fields: [sourceMatchId], references: [id])

  @@index([userId, game, recordedAt])
}

